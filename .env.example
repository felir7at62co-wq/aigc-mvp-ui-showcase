# Copy this file to .env and fill in credentials locally.

# Yunying image/video API. Never commit the real key.
YUNYING_API_KEY=your_yunying_api_key_here
YUNYING_BASE_URL=https://wy6688.token6688.com/v1
YUNYING_VIDEO_MODEL=seedance-2-0-official
YUNYING_IMAGE_MODEL=gpt-image-2-official

# Script analysis / shot-script LLM API.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_MODEL=doubao-seed-2.0-code

# Optional bundled-tool overrides.
# FFMPEG_PATH=
# JIANYING_PATH=
